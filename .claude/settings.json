{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(make check)",
      "Bash(make lint)",
      "Bash(make typecheck)",
      "Bash(make test)",
      "Bash(make build_empty)",
      "Bash(make parse)",
      "Bash(make format)",
      "Bash(make shape)",
      "Bash(uv run pytest *)",
      "Bash(uv run ruff check *)",
      "Bash(uv run mypy *)",
      "Bash(uv run lint-imports)",
      "Bash(uv run dbt parse *)",
      "Bash(uv run dbt compile *)",
      "Bash(uv run dbt ls *)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git show *)"
    ],
    "ask": [
      "Bash(make extract *)",
      "Bash(make maintain *)",
      "Bash(make clean_storage *)",
      "Bash(docker compose down *)",
      "Bash(git push *)"
    ],
    "deny": [
      "Read(./.env)",
      "Edit(./.env)",
      "Read(./secrets/**)",
      "Edit(./secrets/**)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/protect_files.py\"",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/post_edit_check.py\"",
            "timeout": 90,
            "statusMessage": "Checking the edited file"
          }
        ]
      }
    ]
  }
}
