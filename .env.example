# Copy to .env and fill in. `.env` is git-ignored; this file is not, so it holds no real value.
#
# Names carry no project prefix. The dbt profile reads them too, through `env_var`.

# --- Object store (the snapshot lives here) ---------------------------------------------
# Local development credentials. They are not secrets in the sense a cloud key is -- the store
# runs on your machine -- but they are still read from the environment, because the code must not
# be able to tell a local store from a real bucket. Any non-empty value works locally.
S3_ACCESS_KEY=
S3_SECRET_KEY=

# The endpoint is the only thing that differs between this store, another S3-compatible one, and
# a real cloud bucket. Nothing above docker-compose.yml knows which is behind it.
S3_ENDPOINT=localhost:8333
S3_BUCKET=wwi
S3_USE_SSL=false

# --- DuckLake catalog ------------------------------------------------------------------
CATALOG_USER=
CATALOG_PASSWORD=
CATALOG_DB=ducklake
CATALOG_HOST=localhost
CATALOG_PORT=55432

# Key prefix the lake's data files live under, inside the same bucket as the snapshot.
# s3://$S3_BUCKET/$LAKE_PREFIX/ holds the warehouse; s3://$S3_BUCKET/bronze/ holds the snapshot.
LAKE_PREFIX=lake

# --- Source database (stage 1 only) ----------------------------------------------------
# Needed ONLY to refresh the snapshot with `make extract`. The build must never read these: a
# transform step that opens a connection to the source has broken the boundary this design rests
# on. Leave them unset for everything except extraction.

# The only source credential the extraction needs: a read-only login, created by
# infrastructure/mssql/prepare_extraction_login.sql. Consistency comes from a snapshot-isolation
# transaction, so nothing in this pipeline holds a privilege beyond SELECT.
MSSQL_CONNECTION_STRING=
