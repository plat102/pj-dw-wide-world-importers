# Copy to .env and fill in. `.env` is git-ignored; this file is not, so it holds no real value.
#
# Names carry no project prefix. The dbt profile reads them too, through `env_var`.
#
# No quote marks around values: make keeps them as part of the value and docker compose strips
# them, so the store and its clients would hold different secrets. `wwi` refuses a quoted one.

# --- Object store (the lake's data files live here) --------------------------------------
# Local development credentials. They are not secrets in the sense a cloud key is -- the store
# runs on your machine -- but they are still read from the environment, because the code must not
# be able to tell a local store from a real bucket. Any non-empty value works locally.
S3_ACCESS_KEY=
S3_SECRET_KEY=

# The endpoint is the only thing that differs between this store, another S3-compatible one, and
# a real cloud bucket. Nothing above docker-compose.yml knows which is behind it.
S3_ENDPOINT=localhost:8333
S3_BUCKET=wwi
S3_USE_SSL=false

# --- DuckLake catalog ------------------------------------------------------------------
CATALOG_USER=
CATALOG_PASSWORD=
CATALOG_DB=ducklake
CATALOG_HOST=localhost
CATALOG_PORT=55432

# --- Published ports --------------------------------------------------------------------
# docker compose reads this; nothing else does. Both ports carry admin credentials, so they
# listen on loopback unless this says otherwise.
BIND_ADDRESS=127.0.0.1

# Key prefix the lake's data files live under. s3://$S3_BUCKET/$LAKE_PREFIX/ holds every layer,
# bronze included: a layer is a schema of the catalog, not a prefix on the store.
LAKE_PREFIX=lake

# --- Source database (stage 1 only) ----------------------------------------------------
# Needed ONLY to reload bronze with `make extract`. The build must never read these: a
# transform step that opens a connection to the source has broken the boundary this design rests
# on. The Makefile passes MSSQL_CONNECTION_STRING to `make extract` alone, so keeping it in this
# file does not put it in the environment of any other recipe.

# The only source credential the extraction needs: a read-only login, created by
# infrastructure/mssql/prepare_extraction_login.sql. Nothing in this pipeline holds a privilege
# beyond SELECT -- no CDC, no schema changes, no write of any kind on the source.
#
# Shape, with the three words to replace (no angle brackets: this file gets sourced by hand,
# and a `<` in it is read as a redirect):
#   mssql+pymssql://LOGIN:PASSWORD@HOST:1433/
#   LOGIN     the EXTRACT_LOGIN passed to prepare_extraction_login.sql, e.g. wwi_extract
#   PASSWORD  the EXTRACT_PASSWORD for it. Percent-encode any of : / ? @ in it -- a raw @ or /
#             truncates the URL, and the error then points somewhere else
#   HOST      where SQL Server answers. From WSL2 to a Windows host that is the host's LAN
#             address, not localhost. The port is 1433 unless the instance was moved
# The database name is not written here: `make extract --source-db` supplies it, so one
# credential can point at a restored copy without editing this file.
MSSQL_CONNECTION_STRING=
