.vscode/*
# settings.json stays ignored: the Python extension rewrites it with machine-local env state.
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
!.vscode/*.code-snippets

# Local History for Visual Studio Code
.history/

# Built Visual Studio Code Extensions
*.vsix

.vs/*
.idea/*

/secrets/*

.venv/*

logs/*

wide_world_importers_dw/profiles*.yml

# package-lock.yml is tracked on purpose: it is what pins dbt_utils across machines.


*.env
*/secrets/*
# The Parquet snapshot is published output, never repository content. Only the manifest that
# describes it is tracked -- see data/snapshots/manifest.json. `make extract` writes the snapshot
# straight to the object store, so nothing lands here any more; the rule stays so an older
# working copy cannot commit one by accident.
data/raw/

# Nothing in the build produces this any more; the read-only DuckDB client recreates it on
# connect, so it stays ignored rather than tracked.
*.duckdb
*.duckdb.wal

__pycache__/
*.py[cod]

# setuptools writes this when the project is installed into the venv. Build output, not source.
*.egg-info/

# Local credentials for the object store, the catalog and the source. `.env.example` is tracked
# and holds no value; `.env` holds the values and never is. `*.env` above already covers it, but
# the name is spelled out because it is the file that matters most.
.env
